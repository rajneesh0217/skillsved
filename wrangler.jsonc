{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "skillsved",
    "main": "cloudflare/worker.js",
    "compatibility_date": "2026-10-05",

    "assets": {
        "directory": "./frontend",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },

    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "skillsved-db",
            "database_id": "9bb521c3-9854-4429-a219-65e2be20c328"
        }
    ],

    "ratelimits": [
    {
        "name": "CONTACT_RATE_LIMITER",
        "namespace_id": "1001",
        "simple": {
            "limit": 10,
            "period": 60
        }
    },
    {
        "name": "ADMIN_RATE_LIMITER",
        "namespace_id": "1002",
        "simple": {
            "limit": 5,
            "period": 60
        }
    }
]
}
